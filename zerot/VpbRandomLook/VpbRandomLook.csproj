<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>VpbRandomLook</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net40</TargetFramework>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>15.0</LangVersion>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\UiKit\RlChrome.cs" Link="UiKit\RlChrome.cs" />
    <Compile Include="..\UiKit\RlExternal.cs" Link="UiKit\RlExternal.cs" />
    <Compile Include="..\UiKit\RlImguiExternal.cs" Link="UiKit\RlImguiExternal.cs" />
    <Reference Include="BepInEx" />
    <Reference Include="Assembly-CSharp" />
    <Reference Include="UnityEngine" />
    <Reference Include="UnityEngine.CoreModule" />
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(VaMManagedDir)\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Companion API. Compile-time reference on purpose: a VPB rename must break the build here
         rather than silently no-op at runtime. Never copied locally - VPB.dll is loaded by BepInEx. -->
    <Reference Include="VPB">
      <HintPath>$(VaMDir)\BepInEx\plugins\VPB.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
